# ============================================================
# Lab Local Agent Kit (Ollama + Open WebUI + Harnessmith)
# 複製為 .env 或直接執行 `bash init.sh` 自動產生不撞 Port 的設定
# ============================================================

# 個人資料根目錄（每個人的模型、對話、Harness 記憶完全獨立）
# 若常跨 host / host2 排程，可改成 /mnt/nas_home/<你的帳號>/local-agent-data
DATA_DIR=$HOME/local-agent-data

# 每個人的專屬 Port（同一節點多人同時運行時必須不同，init.sh 會依 UID 自動錯開）
OLLAMA_PORT=11434
WEBUI_PORT=13000
HARNESS_PORT=8765
AUTOSYNC_PORT=8766

# 服務內部連線 URL（通常隨上面 Port 自動對應）
OPENWEBUI_URL=http://127.0.0.1:13000
HARNESS_URL=http://127.0.0.1:8765
HARNESSMITH_URL=http://127.0.0.1:8765
AUTOSYNC_HOST=127.0.0.1

# 映像檔位置（init.sh 會自動從 Docker Hub / GHCR 匯入；若之後放進 /mnt/shared_dataset/enroot-library/ 也可直接指過去）
OLLAMA_IMAGE=$HOME/lab-agent-kit/images/ollama.sqsh
WEBUI_IMAGE=$HOME/lab-agent-kit/images/open-webui.sqsh

# Ollama 效能與記憶體參數
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Harnessmith 獨立資料路徑
HARNESS2_RUNS_DIR=$HOME/local-agent-data/harnessmith/runs
HARNESS2_CONNECTIONS=$HOME/local-agent-data/harnessmith/connections.json
HARNESSMITH_PROJECT=agent-harness-lab

# 安全 Token（init.sh 會自動生成隨機字串；OPENWEBUI_API_KEY 需登入 WebUI 後補填）
HARNESS2_HOOK_TOKEN=replace-with-random-token
HARNESS2_AUTOSYNC_TOKEN=replace-with-random-token
OPENWEBUI_API_KEY=
